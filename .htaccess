# Text responses compress. The film does not: gzipping it breaks seeking.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 365 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType audio/mpeg "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # Asset URLs carry ?v=N, so a one-year immutable cache is safe and removes
  # the revalidation round trip for every one of the 633 scroll frames.
  <FilesMatch "\.(css|js|webp|jpe?g|woff2|mp3)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# This host stamps Last-Modified with the current time. Chrome then rejects
# the range it needs for the next frame, so the film stays on one chapter.
<Files "frames.bin">
  FileETag None
  <IfModule mod_headers.c>
    Header always unset ETag
    Header unset Last-Modified
    Header always unset Last-Modified
    Header always unset Content-Encoding
    Header always set Accept-Ranges "bytes"
    Header always set Cache-Control "public, max-age=2592000"
    Header always set Content-Type "application/octet-stream"
    RequestHeader unset If-Range
    RequestHeader unset If-Modified-Since
    RequestHeader unset If-None-Match
  </IfModule>
  SetEnv no-gzip 1
  SetEnv dont-vary 1
</Files>

<FilesMatch "\.mp4$">
  FileETag None
  <IfModule mod_headers.c>
    Header always unset ETag
    Header always unset Last-Modified
    Header always unset Content-Encoding
    Header always set Accept-Ranges "bytes"
    Header always set Cache-Control "public, max-age=2592000"
  </IfModule>
  SetEnv no-gzip 1
  SetEnv dont-vary 1
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Text assets compress; media must not (gzip breaks video range requests).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/ld+json application/xml text/xml
</IfModule>
